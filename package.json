    "@capacitor/haptics": "8.0.2",
    "@supabase/supabase-js": "2.75.0",
    "cordova-plugin-purchase": "13.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "typescript": "5.9.3",
    "vite": "8.0.5",
    "vitest": "4.0.6",
    "eslint": "10.14.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1"
  }
