# Copy to .env.local (gitignored) for local development once your Supabase project exists.
# These are PUBLIC values (the anon key is safe to ship in client code — RLS does the real
# access control) and also need to be added as GitHub Actions repo secrets with the same
# names so CI builds pick them up. The game runs fully offline without either set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
